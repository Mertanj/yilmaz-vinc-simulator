{
  "name": "yilmaz-vinc-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "spike": "node spikes/01-pendulum-and-cable-force.mjs",
    "sahne": "npm run sahne:vinc && npm run sahne:forklift",
    "sahne:vinc": "esbuild tools/headless.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sahne.mjs --log-level=warning && node node_modules/.cache/sahne.mjs",
    "sahne:forklift": "esbuild tools/forkliftSahne.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fsahne.mjs --log-level=warning && node node_modules/.cache/fsahne.mjs",
    "skor": "esbuild tools/skorTesti.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/skorTesti.mjs --log-level=warning && node node_modules/.cache/skorTesti.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "planck": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
